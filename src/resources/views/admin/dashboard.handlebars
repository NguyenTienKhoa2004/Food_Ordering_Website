<!-- Handlebars Helper for eq -->
<script>

document.addEventListener('DOMContentLoaded', function() {
    const detailsModal = document.getElementById('detailsModal');
    const orderDetailsButtons = document.querySelectorAll('.order-details');
    const closeModalBtn = document.getElementById('closeModal'); // Fixed ID
    const closeModalBtnSecondary = document.getElementById('closeModalBtn');

    if (!detailsModal) {
        console.error('Modal element with ID detailsModal not found');
        return;
    }

    function openDetailsModal(data) {
        document.getElementById('modal-user-id').textContent = data.id || 'N/A';
        document.getElementById('modal-product-name').textContent = data.name || 'N/A';
        document.getElementById('modal-date').textContent = data.date || 'N/A';
        document.getElementById('modal-total').textContent = data.total || '0';
        document.getElementById('modal-status').textContent = data.status || 'N/A';
        document.getElementById('modal-street').textContent = data.street || 'N/A';
        document.getElementById('modal-city').textContent = data.city || 'N/A';
        document.getElementById('modal-postal').textContent = data.postal || 'N/A';
        document.getElementById('modal-payment').textContent = data.payment || 'N/A';

        detailsModal.style.display = 'flex'; // Show modal
        detailsModal.classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function closeDetailsModal() {
        detailsModal.classList.remove('active');
        detailsModal.style.display = 'none'; // Hide modal
        document.body.style.overflow = '';
    }

    orderDetailsButtons.forEach(button => {
        button.addEventListener('click', function(e) {
            e.preventDefault();
            const data = {
                id: this.getAttribute('data-id'),
                name: this.getAttribute('data-product-name'),
                date: this.getAttribute('data-date'),
                total: this.getAttribute('data-total'),
                status: this.getAttribute('data-status'),
                street: this.getAttribute('data-street'),
                city: this.getAttribute('data-city'),
                postal: this.getAttribute('data-postal'),
                payment: this.getAttribute('data-payment')
            };
            openDetailsModal(data);
        });
    });

    if (closeModalBtn) {
        closeModalBtn.addEventListener('click', closeDetailsModal);
    } else {
        console.warn('Close button with ID closeModal not found');
    }

    if (closeModalBtnSecondary) {
        closeModalBtnSecondary.addEventListener('click', closeDetailsModal);
    } else {
        console.warn('Close button with ID closeModalBtn not found');
    }

    detailsModal.addEventListener('click', function(e) {
        if (e.target === detailsModal) {
            closeDetailsModal();
        }
    });
});

// Handlebars Helper for eq (already included)
Handlebars.registerHelper('eq', function(a, b) {
    return a === b;
});
</script>

<style>
  .modal-overlay {
    display: none; /* Hidden by default */
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5); /* Semi-transparent backdrop */
    z-index: 1000;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.modal-overlay.active {
    display: flex; /* Show when active */
    opacity: 1;
}

.order-details-modal {
    background: #fff;
    border-radius: 8px;
    padding: 20px;
    width: 90%;
    max-width: 500px; /* Increased for better readability */
    max-height: 80vh;
    overflow-y: auto;
    transform: scale(0.8);
    transition: transform 0.3s ease;
}

.modal-overlay.active .order-details-modal {
    transform: scale(1);
}

.btn-close {
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
}

.modal-body p {
    margin: 0.5rem 0;
}

.order-card {
    margin-bottom: 1.6rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    line-height: 1.7;
}

.card-body {
    padding: 1.6rem;
}

.card-title {
    font-size: 1.6rem;
    font-weight: 600;
    margin-bottom: 1rem;
}
  


</style>







