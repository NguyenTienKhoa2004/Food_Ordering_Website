    <section class="my-5">
    <h2>Manage Orders</h2>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>User</th>
                <th>Total</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {{#each orders}}
            <tr>
                <td>{{this.id}}</td>
                <td>{{this.username}}</td>
                <td>${{this.total}}</td>
                <td>{{this.status}}</td>
                <td>
                    <form action="/me/{{this.id}}/status" method="POST" class="d-inline">
                        <select name="status" onchange="this.form.submit()">
                            <option value="pending" {{#if (eq this.status 'pending')}}selected{{/if}}>Pending</option>
                            <option value="confirmed" {{#if (eq this.status 'confirmed')}}selected{{/if}}>Confirmed</option>
                            <option value="cancelled" {{#if (eq this.status 'cancelled')}}selected{{/if}}>Cancelled</option>
                        </select>
                    </form>
                    <button class="btn order-details btn-primary" 
                            data-id="{{this.user_id}}"
                            data-product-name="{{this.product_name}}"
                            data-date="{{this.created_at}}"
                            data-total="{{this.total}}"
                            data-status="{{this.status}}"
                            data-street="{{this.street}}"
                            data-city="{{this.city}}"
                            data-postal="{{this.postal}}"
                            data-payment="{{this.payment_method}}">Order Details</button>
                    <form action="/me/{{this.id}}/done" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure?')">Done</button>
                    </form>
                    <form action="/order/{{this.id}}?_method=DELETE" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure?')">Delete</button>
                    </form>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</section>
