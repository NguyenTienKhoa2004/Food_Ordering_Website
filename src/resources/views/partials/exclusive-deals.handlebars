<style>
.exclusive-deals {
  padding: 40px;
  background: #fff;
}

.exclusive-deals .ex-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.exclusive-deals h2 {
  font-size: 2.4rem;
  font-weight: 600;
  color: #000;
}

.badge {
  position: absolute;
  top: 12px;
  right: 12px;
  background: #1c2a3a;
  color: #fff;
  padding: 4px 12px;
  border-radius: 12px;
  font-weight: bold;
}

.info .type {
  text-align: center;
  font-size: 1.6rem;
}

.info h3 {
  text-align: center;
  font-size: 1.6rem;
  margin-top: 5px;
  text-align: start;
}

.ex-deals-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.ex-deals-container {
  display: flex;
  overflow-x: auto;
  scroll-behavior: smooth;
  padding-bottom: 1rem;
  -webkit-overflow-scrolling: touch; /* Smooth scrolling on iOS */
}

.ex-deals-container::-webkit-scrollbar {
  height: 0px;
}

.ex-deals-container::-webkit-scrollbar-thumb {
  background: #ccc;
  border-radius: 0px;
}

.ex-deals-container::-webkit-scrollbar-track {
  background: #f1f1f1;
}

.ex-deals-card {
  transition: transform 0.3s ease;
  border: none;
  background: #ffffff;
  border-radius: 0px;
  overflow: hidden;
  min-width: 300px; /* Fixed width for cards */
  margin-right: 1rem; /* Space between cards */
  background-color: #ffffff;
  height: 225px;
}

.ex-deals-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

.ex-deals-img {
  height: 200px;
  object-fit: cover;
}

.scroll-btn {
  background: #1c2a3a;
  color: #fff;
  border: none;
  border-radius: 50%;
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  position: absolute;
  z-index: 10;
  font-size: 1.5rem;
  transition: background 0.3s ease;
}

.scroll-btn:hover {
  background: #2a3b52;
}

.left-btn {
  left: -20px;
}

.right-btn {
  right: -20px;
}
</style>

<script>
function scrollDeals(direction) {
  const container = document.querySelector('.ex-deals-container');
  const cardWidth = 300 + 16; // Card width (300px) + margin-right (16px)
  const scrollAmount = direction === 'left' ? -cardWidth : cardWidth;
  container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
}
</script>
