<div class ="order-section">
  {{#each cart}}
    <div class="card order-card">
      <div class="card-header order-card-header">
          Order #{{this.id}}
      </div>
      <div class="card-body">
          <h5 class="card-title">Customer: {{this.user_id}}</h5>
          <p class="card-text">
              <strong>Product name:</strong> {{this.product_name}}<br>
              <strong>Date:</strong> {{this.created_at}}<br>
              <strong>Total:</strong> ${{this.total}}<br>
              <strong>Status:</strong> {{this.status}}
          </p>
          <form action="/order/{{this.id}}/cancel" method="POST" class="d-inline cancel-order-form">
                  <input type="hidden" name="status" value="cancelled">
                  <button type="submit" class="btn btn-primary text-danger">Cancel Order</button>
          </form>
          {{!-- <a href="/order/track/{{this.id}}" class="btn btn-primary" >Details</a> --}}
          <button class ="btn order-details btn-primary" data-id="{{this.user_id}}"
                data-product-name="{{this.product_name}}"
                data-date="{{this.created_at}}"
                data-total="{{this.total}}"
                data-status="{{this.status}}"
                data-street="{{this.street}}"
                data-city="{{this.city}}"
                data-postal="{{this.postal}}"
                data-payment="{{this.payment_method}}"> Order Details </button>
          </div>
      </div>
  {{/each}}
</div>

{{!-- Order Details Modal --}}
<div id="detailsModal" class=" modal-overlay">
    <div class=" order-details-modal">
        <div class="flex justify-between items-center mb-4">
            <h2>Order Details</h2>
            
        </div>
        <div class="modal-body">
            <p><strong>Customer ID:</strong> <span id="modal-user-id"></span></p>
            <p><strong>Product Name:</strong> <span id="modal-product-name"></span></p>
            <p><strong>Date:</strong> <span id="modal-date"></span></p>
            <p><strong>Total:</strong> $<span id="modal-total"></span></p>
            <p><strong>Status:</strong> <span id="modal-status"></span></p>
            <p><strong>Street:</strong> <span id="modal-street"></span></p>
            <p><strong>City:</strong> <span id="modal-city"></span></p>
            <p><strong>Postal Code:</strong> <span id="modal-postal"></span></p>
            <p><strong>Payment Method:</strong> <span id="modal-payment"></span></p>
        </div>
        <div class="mt-6 flex justify-end">
            <button id="closeModalBtn" class="btn btn-primary bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">Close</button>
        </div>
    </div>
</div>
{{!--Confirm delete--}}
<div id="delete-modal" class="modal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Delete this?</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>Are you sure?</p>
      </div>
      <div class="modal-footer">
        <button id="btn-delete-item"type="button" class="btn btn-danger" data-bs-dismiss="modal">Delete</button>
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Cancel</button>
      </div>
    </div>
  </div>
</div>
{{!--Delete form --}}
<form id="delete-item-form" method="POST" style="display:none;"></form>


<script>
    document.addEventListener('DOMContentLoaded', function() {
        const detailsModal = document.getElementById('detailsModal');
        const orderDetailsButtons = document.querySelectorAll('.order-details');
        const closeModalBtn = document.getElementById('closeModal');
        const closeModalBtnSecondary = document.getElementById('closeModalBtn');

        // Check if modal exists
        if (!detailsModal) {
            console.error('Modal element with ID detailsModal not found');
            return;
        }

        // Function to open modal and populate data
        function openDetailsModal(data) {
            const userIdElement = document.getElementById('modal-user-id');
            const product_nameElement = document.getElementById('modal-product-name');
            const dateElement = document.getElementById('modal-date');
            const totalElement = document.getElementById('modal-total');
            const statusElement = document.getElementById('modal-status');
            const streetElement = document.getElementById('modal-street');
            const cityElement = document.getElementById('modal-city');  
            const postalElement = document.getElementById('modal-postal');
            const paymentElement = document.getElementById('modal-payment');

            // Check if all modal elements exist
            if (!userIdElement || !dateElement || !totalElement || !statusElement) {
                console.error('One or more modal elements not found');
                return;
            }

            userIdElement.textContent = data.id;
            product_nameElement.textContent = data.name;
            dateElement.textContent = data.date;
            totalElement.textContent = data.total;
            statusElement.textContent = data.status;
            streetElement.textContent = data.street;
            cityElement.textContent = data.city;
            postalElement.textContent = data.postal;
            paymentElement.textContent = data.payment;
            
            detailsModal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        // Function to close modal
        function closeDetailsModal() {
            detailsModal.classList.remove('active');
            document.body.style.overflow = '';
        }

        // Attach event listeners to all order-details buttons
        orderDetailsButtons.forEach(button => {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                const data = {
                    id: this.getAttribute('data-id'),
                    name: this.getAttribute('data-product-name'),
                    date: this.getAttribute('data-date'),
                    total: this.getAttribute('data-total'),
                    status: this.getAttribute('data-status'),
                    street: this.getAttribute('data-street'),
                    city: this.getAttribute('data-city'),   
                    postal: this.getAttribute('data-postal'),
                    payment: this.getAttribute('data-payment')
                };
                openDetailsModal(data);
            });
        });

        // Event listener for close button (×)
        if (closeModalBtn) {
            closeModalBtn.addEventListener('click', closeDetailsModal);
        } else {
            console.warn('Close button with ID closeModal not found');
        }

        // Event listener for secondary close button (Close)
        if (closeModalBtnSecondary) {
            closeModalBtnSecondary.addEventListener('click', closeDetailsModal);
        } else {
            console.warn('Close button with ID closeModalBtn not found');
        }

        // Close modal when clicking outside
        detailsModal.addEventListener('click', function(e) {
            if (e.target === detailsModal) {
                closeDetailsModal();
            }
        });
    });
</script>

<style>
  .order-card {
      margin-bottom: 1.6rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      line-height: 1.7;
  }
  .order-card-header {

      background-color: #f8f9fa;
      font-weight: bold;
      line-height: 1.5;
      padding: 1rem;
  }
  .card-body {
    padding: 1.6rem;
  }
  .card-title {
    font-size: 1.6rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .modal {
    z-index: 1000;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .modal.active {
      display: flex;
      opacity: 1;
  }
  .modal-content {
      width: 300px;
      height: 300px;
      overflow-y: auto;
      transform: scale(0.8);
      transition: transform 0.3s ease;
  }
  .modal.active .modal-content {
      transform: scale(1);
  }

  


</style>