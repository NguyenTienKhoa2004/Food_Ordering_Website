<div class="container2">
  <section class="menu-section">
    <div class="container-fluid">
      <h2 class="section-title">Our Delicious Menu</h2>
      <div class="row">
        <!-- Category List -->
        <div class="col-md-2 category-sidebar">
          <nav class="category-nav" role="tablist">
            <a class="category-btn {{isActive currentPath '/menu'}}" href="/menu" data-category="all" aria-selected="true">All</button>
            <a class="category-btn {{isActive currentPath '/category/chicken'}}" href="/category/chicken" data-category="friedchicken" aria-selected="false">Fried Chicken</a>
            <a class="category-btn {{isActive currentPath '/category/burger'}}" href="/category/burger" data-category="burger" aria-selected="false">Burger</a>
            <a class="category-btn {{isActive currentPath '/category/noodle'}}" href="/category/noodle" data-category="noodle" aria-selected="false">Noodle</a>
            <a class="category-btn {{isActive currentPath '/category/frenchfried'}}" href="/category/frenchfried" data-category="frenchfried" aria-selected="false">French Fried</a>
            <a class="category-btn {{isActive currentPath '/category/drinks'}}" href="/category/drinks" data-category="drinks" aria-selected="false">Drinks</a>
          </nav>
        </div>
        <!-- Menu Items -->
        <div class="col-md-10 listProduct">
          <div class="row" id="menu-items">
            {{#each items}}
            <div class="col-lg-4 col-md-6 menu-card" data-category="{{this.category}}">
              <a href="/menu/{{this.slug}}">
              <img src="{{this.image}}" alt="{{this.name}}">
              </a>
              <div class="menu-card-body">
                <h5 class="menu-card-title">{{this.name}}</h5>
                <p class="menu-card-text">{{this.description}}</p>
                <p class="menu-card-price">${{this.price}}</p>
                <a class="btn btn-order-now" data-id ="{{this.id}}"
                data-name="{{this.name}}" data-image="{{this.image}}" data-price="{{this.price}}">Chọn món</a>
              </div>
            </div>
            {{/each}}
          </div>
        </div>
      </div>
    </div> 
  </section>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();

  // Listen for new item events
  socket.on('newItem', (newItem) => {
    const menuItems = document.getElementById('menu-items');
    const currentCategory = document.querySelector('.category-btn[aria-selected="true"]').dataset.category;

    // Only append if the item matches the current category or 'all' is selected
    if (currentCategory === 'all' || currentCategory === newItem.category) {
      const itemDiv = document.createElement('div');
      itemDiv.className = 'col-lg-4 col-md-6 menu-card';
      itemDiv.dataset.category = newItem.category;
      itemDiv.innerHTML = `
        <a href="/menu/${newItem.slug}">
          <img src="${newItem.image}" alt="${newItem.name}">
        </a>
        <div class="menu-card-body">
          <h5 class="menu-card-title">${newItem.name}</h5>
          <p class="menu-card-text">${newItem.description}</p>
          <p class="menu-card-price">$${newItem.price}</p>
          <a class="btn btn-order-now" data-id="${newItem.id}"
            data-name="${newItem.name}" data-image="${newItem.image}" data-price="${newItem.price}">Chọn món</a>
        </div>
      `;
      menuItems.appendChild(itemDiv);
    }
  });
</script>